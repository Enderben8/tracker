# Build output and caches
.gradle/
build/
.kotlin/

# Per-machine settings (Android SDK location)
local.properties

# Databases - the app's data lives in %LOCALAPPDATA%\RevisionTracker, never in the repo
*.db
*.db-wal
*.db-shm

# Signing keys must never be committed
*.jks
*.keystore

# Downloaded specification pages: ~60MB, refetchable with tools/spec_tool.py fetch.
# The distilled wording in tools/evidence/ is committed instead, and is what verify reads.
tools/sources/
__pycache__/

# IDEs and OS clutter
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
